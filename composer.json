{
  "name": "livebuzz/essentials-sdk",
  "description": "SDK Essentials",
  "keywords": [
    "essentials",
    "laravel",
    "php",
    "sdk"
  ],
  "license": "MIT",
  "type": "package",
  "require": {
    "php": "^8.3",
    "guzzlehttp/guzzle": "^7.15",
    "symfony/http-kernel": "^7.4",
    "illuminate/support": "^13.0",
    "nesbot/carbon": "^3.9",
    "laravel/helpers": "^1.8"
  },
  "require-dev": {
    "phpunit/phpunit": "~12.0",
    "mockery/mockery": "*",
    "fakerphp/faker": "^1.9.1",
    "laravel/pint": "^1.29"
  },
  "autoload-dev": {
    "classmap": [
      "tests/TestCase.php"
    ],
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "autoload": {
    "psr-4": {
      "Buzz\\EssentialsSdk\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "config": {
    "preferred-install": "dist"
  }
}
